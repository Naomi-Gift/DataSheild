## DataShield root env example
## Copy to the relevant sub-project env files as needed.
##
## - contracts: create `datashield/contracts/.env` from values below
## - backend:   create `datashield/backend/.env` from values below
## - frontend:  create `datashield/frontend/.env.local` from values below

PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY
ORACLE_PRIVATE_KEY=0x_YOUR_ORACLE_PRIVATE_KEY
OG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16600

OG_INDEXER_RPC=https://indexer-storage-testnet-standard.0g.ai
DATASEAL_NFT_ADDRESS=0x_FILL_AFTER_DEPLOY
DATAMARKET_ADDRESS=0x_FILL_AFTER_DEPLOY
OG_TOKEN_ADDRESS=0x_0G_TESTNET_TOKEN_ADDRESS
REDIS_URL=redis://localhost:6379
PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_OG_CHAIN_ID=16600
NEXT_PUBLIC_OG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_DATASEAL_ADDRESS=0x_FILL_AFTER_DEPLOY
NEXT_PUBLIC_DATAMARKET_ADDRESS=0x_FILL_AFTER_DEPLOY
